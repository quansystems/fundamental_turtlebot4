  </link></model>
  <model name="south"><static>true</static><pose>0 -3.075 1 0 0 0</pose><link name="body">
    <collision name="collision"><geometry><box><size>6 0.15 2</size></box></geometry></collision>
    <visual name="visual"><geometry><box><size>6 0.15 2</size></box></geometry><material><ambient>0.3 0.45 0.6 1</ambient><diffuse>0.3 0.45 0.6 1</diffuse></material></visual>
  </link></model>
  <model name="north"><static>true</static><pose>0 3.075 1 0 0 0</pose><link name="body">
    <collision name="collision"><geometry><box><size>6 0.15 2</size></box></geometry></collision>
    <visual name="visual"><geometry><box><size>6 0.15 2</size></box></geometry><material><ambient>0.3 0.45 0.6 1</ambient><diffuse>0.3 0.45 0.6 1</diffuse></material></visual>
  </link></model>
  <model name="divider_left"><static>true</static><pose>-1.9 0.8 0.6 0 0 0</pose><link name="body">
    <collision name="collision"><geometry><box><size>2.2 0.15 1.2</size></box></geometry></collision>
    <visual name="visual"><geometry><box><size>2.2 0.15 1.2</size></box></geometry><material><ambient>0.3 0.45 0.6 1</ambient><diffuse>0.3 0.45 0.6 1</diffuse></material></visual>
  </link></model>
  <model name="divider_right"><static>true</static><pose>1.9 0.8 0.6 0 0 0</pose><link name="body">
    <collision name="collision"><geometry><box><size>2.2 0.15 1.2</size></box></geometry></collision>
